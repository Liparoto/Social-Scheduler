# ---- SocialScheduler install config ----
# This file is a COMMITTED TEMPLATE. Copy it to `.env` and fill in your own values.
# Your real `.env` is gitignored and never leaves this machine.
# Every clone of this repo is an independent install with its OWN values here.

# ---- Database (SQLite, WAL mode) ----
# Per-install DB file. Lives under /data (gitignored). The migrate script creates it.
DATABASE_PATH=./data/socialscheduler.db

# ---- Local asset store ----
# Uploaded images/videos are stored here (dedup by content hash, not filename).
ASSET_STORAGE_DIR=./data/assets

# Public base URL Meta can reach to FETCH your media. LEAVE THIS BLANK for the normal
# setup — the worker automatically opens a short-lived Cloudflare tunnel at publish time
# (see docs/design-publish-delivery.md). Only set it if you host your assets somewhere
# public yourself; then it MUST return raw image/video bytes with a correct content-type
# (no auth, no redirect, no HTML page — Drive/Dropbox SHARE links do NOT work).
PUBLIC_ASSET_BASE_URL=

# ---- Publish delivery (automatic tunnel) ----
# Meta downloads your image from a public URL. The worker briefly serves the local asset
# store on 127.0.0.1:ASSET_PORT and exposes ONLY that via `cloudflared` at publish time,
# then tears it down. Free, no Cloudflare account, nothing to sign up for.
#
# NOTHING TO INSTALL: the first time you run Start-SocialScheduler it downloads the
# cloudflared binary into data/bin/ for you. If you already have your own (e.g. from
# `brew install cloudflared`), that one is used instead and nothing is downloaded.
ASSET_PORT=8787
# Only set this if you keep cloudflared somewhere unusual and want to force a path.
# Left unset, the worker checks your PATH and then this install's own data/bin copy.
# CLOUDFLARED_PATH=cloudflared
# TUNNEL_STARTUP_TIMEOUT=30

# How long to wait for Instagram to finish transcoding a Reel before giving up and
# retrying on a later cycle. 10s x 90 = 15 minutes. Raise if long Reels time out.
# REELS_STATUS_POLL_INTERVAL=10
# REELS_STATUS_POLL_MAX_TRIES=90

# ---- Video conversion on upload ----
# A video that's too wide for Reels (e.g. an iPhone's default 4K 2160x3840 recording),
# too large, or in the wrong container is downscaled/re-encoded automatically instead
# of being refused. Uses whichever of these is available, in order:
# `avconvert` (macOS only, ships with every install, no setup) -> this install's own
# `data/bin/ffmpeg` (`ffmpeg.exe` on Windows — installed automatically by
# Start-SocialScheduler-Windows.bat the first time it runs) -> `ffmpeg` on PATH, if you
# installed one yourself (e.g. `brew install ffmpeg` — macOS only) -> neither, in which
# case the upload is refused with a note that installing ffmpeg would let this happen
# automatically.
# One of: auto | avconvert | ffmpeg | off. "off" disables conversion entirely.
VIDEO_CONVERTER=auto
# How long to let a conversion run before giving up, in seconds.
VIDEO_CONVERT_TIMEOUT=300

# ---- Safety switches ----
# DRY_RUN=1  -> the worker logs exactly what it WOULD publish and posts NOTHING. Start here.
DRY_RUN=1
# KILL_SWITCH=1 -> the worker halts immediately and publishes nothing. Emergency stop.
KILL_SWITCH=0

# ---- Meta app (create your OWN app, keep it in Development mode) ----
# App-level credentials only. Per-CHANNEL access tokens live in the `channels` table,
# configured through the dashboard — NOT in this file.
META_APP_ID=
META_APP_SECRET=
# Graph API version is pinned intentionally (see reference.md). Re-check periodically.
META_GRAPH_VERSION=v25.0
# API host. For the SIMPLE path — "Instagram API with Instagram Login" (no Facebook Page,
# recommended for your own IG account) — set this to https://graph.instagram.com
# For Facebook Pages / the Facebook-Login path, use https://graph.facebook.com (default).
META_GRAPH_BASE=https://graph.facebook.com

# ---- Defaults ----
# Fallback IANA timezone applied to new channels (each channel can override its own).
DEFAULT_TIMEZONE=America/New_York

# How often the worker polls the DB for due work, in seconds.
WORKER_POLL_INTERVAL=30

# ---- Metrics ----
# Only refresh metrics for posts published within this many days...
METRICS_MAX_AGE_DAYS=30
# ...and no more often than this many hours per publication.
METRICS_MIN_INTERVAL_HOURS=6
# Facebook Page-post insight metric(s) for reach/views, comma-separated. Meta deprecated
# many of these on 2026-06-15 and keeps renaming them, so it's configurable here and read
# as BEST-EFFORT: an invalid name just stores a blank reach, it never fails the fetch.
# Reactions, comments and shares don't depend on this — they always work.
FB_POST_INSIGHT_METRICS=post_total_media_view_unique
# Threads insight metric(s), comma-separated. Same reasoning as FB_POST_INSIGHT_METRICS:
# Meta renames insight metrics without warning, so this is configurable rather than
# hardcoded. Unlike Facebook, there is no fallback endpoint — if this call fails, the
# whole metrics snapshot for that post is skipped (logged, not fatal).
THREADS_INSIGHT_METRICS=views,likes,replies,reposts,quotes
# Threads API version. Threads versions its Graph API independently of the Instagram/
# Facebook epoch above (META_GRAPH_VERSION) — do NOT set this to the same value as that.
# Configurable because Meta bumps this without notice; re-check periodically.
THREADS_API_VERSION=v1.0

# ---- TikTok ----
# Register your OWN app at developers.tiktok.com — see docs/tiktok-setup.md. Set the app
# type to DESKTOP (a Web app cannot use a localhost redirect) and register the redirect URI
# exactly: http://localhost:3939/api/channels/tiktok/callback
#
# These are per-install and must never be shared with another clone. TikTok attaches the
# app audit, the posting quotas and the terms of service to the APP, so a shared key makes
# one person accountable for everyone else's posting. A second install registers its own
# app — it costs ten minutes and needs no audit for inbox delivery.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Insights hub ----
# Account-level metric NAMES. Every default below was established by probing the LIVE
# account (python3 -m worker.insights_probe), not from Meta's docs, which lag reality.
# Re-run that probe before changing any of them: Instagram rejects the WHOLE call with a
# 400 if a single name is invalid, so one bad entry loses every metric for that account.
# NOTE `impressions` is absent on purpose — it now 400s in both response shapes. Use views.
# IG_ACCOUNT_SERIES_METRICS=reach,follower_count
# IG_ACCOUNT_TOTAL_METRICS=views,reach,profile_views,accounts_engaged,total_interactions,likes,comments,saves,shares,replies,website_clicks,profile_links_taps
# IG_DEMOGRAPHIC_METRICS=follower_demographics,engaged_audience_demographics,reached_audience_demographics
# IG_DEMOGRAPHIC_BREAKDOWNS=age,gender,city,country
# THREADS_ACCOUNT_METRICS=views,likes,replies,reposts,quotes,followers_count
# THREADS_DEMOGRAPHIC_BREAKDOWNS=age,gender,city,country

# How much history to mirror on a channel's FIRST sync. Both bounds apply; whichever is
# hit first stops the crawl. Raising these makes the first run slower and spends more of
# Meta's rate limit — it does not change anything after that.
#
# TO PULL DEEPER HISTORY LATER, raising this is NOT enough on its own. Once a channel
# finishes its first backfill the sync flips to a small recent-window refresh, so it never
# walks far enough back to notice the new bound. Raise the value AND clear the flag:
#
#     sqlite3 data/socialscheduler.db \
#       "UPDATE channels SET media_backfill_complete = 0 WHERE id = <channel id>;"
#
# The next cycle then does a full walk. Existing rows are upserted, so nothing duplicates.
# Done on 2026-08-23 to take a Facebook Page from 2 years (132 posts) to 5 (360).
# MEDIA_SYNC_MAX_AGE_DAYS=730
# MEDIA_SYNC_MAX_POSTS=2000
# Posts re-checked each cycle once the backfill is done. This is what notices edited
# captions and deleted posts; setting it to 0 would leave the mirror to drift silently.
# MEDIA_SYNC_REFRESH_POSTS=200
# Account-insight history. Meta caps ONE request at ~30 days, so longer spans are walked
# in chunks of ACCOUNT_SERIES_WINDOW_DAYS.
# ACCOUNT_BACKFILL_DAYS=365
# ACCOUNT_SERIES_WINDOW_DAYS=30
# Rate limiting for all the sync jobs. The ceiling is a PERCENTAGE read from Meta's own
# X-Business-Use-Case-Usage header — past it the jobs stop early and resume next cycle,
# so metrics never throttle the publish path.
# INSIGHTS_MAX_CALLS_PER_CYCLE=200
# INSIGHTS_USAGE_PCT_CEILING=80
# INSIGHTS_SYNC_INTERVAL_HOURS=6
# DEMOGRAPHICS_SYNC_INTERVAL_HOURS=24
# Leaderboard thumbnails are cached locally because Meta's CDN links expire. Downscaled
# on arrival (sips) — without that, 118 images cost 115 MB instead of 6 MB.
# THUMBNAIL_MAX_PER_CYCLE=120

# ---- Publish safety ----
# How long a publication may sit at 'publishing' before the worker treats it as abandoned
# and marks it FAILED (never re-queued — it may already be live on the platform).
# This is a safety margin, not a preference: too short and a publish still in flight gets
# recovered and can be sent TWICE. It must stay well clear of the slowest legitimate
# publish, which is a Reel (~17 min: 90 status polls x 10s, plus tunnel startup). RAISE
# THIS if you ever increase REELS_STATUS_POLL_MAX_TRIES.
# PUBLISH_CLAIM_LEASE_SECONDS=1800

# ---------------------------------------------------------------------------
# Launcher
# ---------------------------------------------------------------------------
# How long the worker runs before stopping itself, in hours (default 12).
# The worker publishes for real when DRY_RUN=0, and the launcher runs it with no
# visible window — this timer is what stops a forgotten worker from posting
# unattended for days. Double-clicking Stop always ends it immediately.
# Applies in dry-run too, so the behavior is the same every time.
WORKER_AUTO_STOP_HOURS=12
