# ---- SocialScheduler install config ----
# This file is a COMMITTED TEMPLATE. Copy it to `.env` and fill in your own values.
# Your real `.env` is gitignored and never leaves this machine.
# Every clone of this repo is an independent install with its OWN values here.

# ---- Database (SQLite, WAL mode) ----
# Per-install DB file. Lives under /data (gitignored). The migrate script creates it.
DATABASE_PATH=./data/socialscheduler.db

# ---- Local asset store ----
# Uploaded images/videos are stored here (dedup by content hash, not filename).
ASSET_STORAGE_DIR=./data/assets

# Public base URL Meta can reach to FETCH your media. Meta cURLs image_url server-side,
# so it MUST return raw image/video bytes with a correct content-type — NO auth, NO redirect,
# NO HTML preview page. Google Drive / Dropbox SHARE links do NOT work (they return HTML).
# For local testing, expose your asset store via your own host or a public tunnel.
PUBLIC_ASSET_BASE_URL=

# ---- Safety switches ----
# DRY_RUN=1  -> the worker logs exactly what it WOULD publish and posts NOTHING. Start here.
DRY_RUN=1
# KILL_SWITCH=1 -> the worker halts immediately and publishes nothing. Emergency stop.
KILL_SWITCH=0

# ---- Meta app (create your OWN app, keep it in Development mode) ----
# App-level credentials only. Per-CHANNEL access tokens live in the `channels` table,
# configured through the dashboard — NOT in this file.
META_APP_ID=
META_APP_SECRET=
# Graph API version is pinned intentionally (see reference.md). Re-check periodically.
META_GRAPH_VERSION=v25.0

# ---- Defaults ----
# Fallback IANA timezone applied to new channels (each channel can override its own).
DEFAULT_TIMEZONE=America/New_York

# How often the worker polls the DB for due work, in seconds.
WORKER_POLL_INTERVAL=30
